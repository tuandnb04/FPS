  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>PROTOCOL ZERO // PROJECT HELIOS \u2014 CLASSIFIED BRIEFING</b>\r\nUNIT: Spectre Detachment (Vanguard-09)  |  CLEARANCES: 0/3 ACTS COMPLETED  |  PEAK STAGE: 0/6\r\n\r\n<b>ACT I \u2014 BLACKWATER PIER (MISSION 01)</b>\r\nInfiltrate Ironward's coastal customs dockyard at dusk, neutralize Warden-01 armor, sabotage coastal EW radar and harbor fuel lines, and interrogate Capt. Marko Dragic's shipping terminal.\r\n<color=#A6926F>[STATUS]: Active Priority \u2014 Clear Blackwater Pier to decrypt cargo manifest.</color>\r\n\r\n<b>ACT II \u2014 IRON CORRIDOR (MISSION 02)</b>\r\nIntercept Ironward's armored rail convoy at dawn inside Iron Corridor Gorge, disable Goliath-02 rail armor, cut switchyard power, and defeat Dir. Elena Kastner.\r\n<color=#A6926F>[STATUS]: Locked telemetry \u2014 Defeat Dir. Kastner in Mission 02.</color>\r\n\r\n<b>ACT III \u2014 SILENT PEAK (MISSION 03)</b>\r\nStorm Blackcrest Alpine Citadel by moonlight, overload twin HELIOS EMP capacitor pylons, defeat rogue Col. Radek, and extract aboard Blackhawk VALKYRIE-6.\r\n<color=#A6926F>[STATUS]: Final Strike \u2014 Eliminate Apex-01 aboard Blackcrest Summit.</color>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 1946600965}
