  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>PROTOCOL ZERO // PROJECT HELIOS \u2014 CLASSIFIED BRIEFING</b>\r\nUNIT: Spectre Detachment (Vanguard-09)  |  CLEARANCES: 3/3 ACTS COMPLETED  |  PEAK STAGE: 0/6\r\n\r\n<b>ACT I \u2014 BLACKWATER PIER (MISSION 01)</b>\r\nInfiltrate Ironward's coastal customs dockyard at dusk, neutralize Warden-01 armor, sabotage coastal EW radar and harbor fuel lines, and interrogate Capt. Marko Dragic's shipping terminal.\r\n<color=#49C96E>[DECRYPTED LOG]: Train #774 carrying three seismic HELIOS cores departed inland through Iron Corridor Canyon.</color>\r\n\r\n<b>ACT II \u2014 IRON CORRIDOR (MISSION 02)</b>\r\nIntercept Ironward's armored rail convoy at dawn inside Iron Corridor Gorge, disable Goliath-02 rail armor, cut switchyard power, and defeat Dir. Elena Kastner.\r\n<color=#49C96E>[DECRYPTED LOG]: Kastner staged the gorge ambush as a delay \u2014 Col. Artem Radek is already arming HELIOS at Blackcrest Peak.</color>\r\n\r\n<b>ACT III \u2014 SILENT PEAK (MISSION 03)</b>\r\nStorm Blackcrest Alpine Citadel by moonlight, overload twin HELIOS EMP capacitor pylons, defeat rogue Col. Radek, and extract aboard Blackhawk VALKYRIE-6.\r\n<color=#49C96E>[OPERATION COMPLETE]: Project HELIOS orbital array neutralised cleanly. All Spectre operatives extracted alive.</color>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 1666632530}
